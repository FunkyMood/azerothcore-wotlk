/cmake-build-debug/*
/build*/
/var/*
!/var/build/.gitkeep
!/var/ccache/.gitkeep
/env/dist/*
!/env/dist/.gitkeep
/env/user/*
/.env*
.idea
!.gitkeep

# do not ignore the ccache folder (used by the ci)
!/var/docker/ccache

# Local backups and reference copies are not build inputs.
/backups/*
/backup_db/*
/dbc-backup/*
/lua_scripts_backup_*/*
# Runtime data and logs are mounted separately and are not compilation inputs.
/data/*
/logs/*
/modules/*/.git/*
/.git
